# Copy to .env and fill in real values. Never commit the real .env file.
# docker-compose reads this automatically because it's named ".env" in the same
# directory as docker-compose.yml.

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=linkedin_content_manager

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- JWT (.NET API) ----
# Required, no default — the API refuses to start without it. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SIGNING_KEY=
JWT_ISSUER=LinkedInContentManager
JWT_AUDIENCE=LinkedInContentManager.Clients

# ---- CrewAI service ----
# Required — the five agents cannot run without a real OpenAI key, and the Trend
# Researcher agent's SerperDevTool cannot run without a real Serper key.
OPENAI_API_KEY=
SERPER_API_KEY=
# Shared secret the .NET API sends on every call to the CrewAI service. Leave blank
# for local dev only; set it for anything reachable outside localhost.
CREWAI_SERVICE_API_KEY=

# ---- CORS ----
# The Angular dashboard's origin.
CORS_ALLOWED_ORIGIN=http://localhost:4200
