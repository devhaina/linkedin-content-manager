{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgreSql": "Host=localhost;Port=5432;Database=linkedin_content_manager;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "CrewAiService": {
    "BaseUrl": "http://localhost:8000",
    "ApiKey": "",
    "TimeoutSeconds": 180,
    "RetryCount": 2,
    "CircuitBreakerFailureThreshold": 5
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ContentGenerationQueueName": "content-generation-jobs"
  },
  "Jwt": {
    "SigningKey": "",
    "Issuer": "LinkedInContentManager",
    "Audience": "LinkedInContentManager.Clients",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 14
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  }
}
