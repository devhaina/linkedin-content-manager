# Copy to .env and fill in real values. Never commit the real .env file.

# Required — OpenAI API key used by all five CrewAI agents (GPT-4o).
OPENAI_API_KEY=

# Required — Serper.dev API key used by the Trend Researcher agent's SerperDevTool.
SERPER_API_KEY=

# Host/port the FastAPI service binds to.
CREWAI_SERVICE_HOST=0.0.0.0
CREWAI_SERVICE_PORT=8000

# Shared secret the .NET backend sends on every call to this service, checked
# by the FastAPI service before running a crew.
CREWAI_SERVICE_API_KEY=
